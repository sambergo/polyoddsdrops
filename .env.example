# Polydrop Configuration
# Copy to .env and adjust as needed. All values below are defaults.

# --- General ---
POLYDROP_DB_PATH=data/polydrop.db
POLYDROP_SPORTS=all                        # Comma-separated: nfl,nba,nhl,mlb,ncaab — or "all"
POLYDROP_REFRESH_INTERVAL_SECONDS=7200     # Re-fetch market list every N seconds (0 to disable)
POLYDROP_LOG_LEVEL=INFO

# --- Market Filters ---
POLYDROP_MIN_LIQUIDITY=10000               # Minimum liquidity (USD)
POLYDROP_MAX_SPREAD=0.10                   # Max bid-ask spread ($)
POLYDROP_MIN_VOLUME_24H=100                # Minimum 24h volume (USD)
POLYDROP_MIN_PRICE=0.20                    # Exclude odds below this
POLYDROP_MAX_PRICE=0.90                    # Exclude odds above this

# --- Monitoring (rolling window) ---
POLYDROP_WINDOW_SECONDS=60                 # Rolling window duration
POLYDROP_MAX_DATA_POINTS=100               # Max observations per window
POLYDROP_LOG_INTERVAL_SECONDS=30           # Stats logging frequency

# --- Alert Detection ---
POLYDROP_ALERT_THRESHOLD_PCT=7.0           # % change to trigger alert
POLYDROP_ALERT_COOLDOWN_SECONDS=300        # Cooldown between alerts per token
POLYDROP_ALERT_MIN_OBSERVATIONS=3          # Min data points before alerting
POLYDROP_ALERT_CUTOFF_BEFORE_START=180     # Skip events starting within N seconds

# --- Redis ---
POLYDROP_REDIS_URL=redis://localhost:6379/0
POLYDROP_REDIS_PREFIX=polydrop
POLYDROP_REDIS_TOKEN_TTL=1800              # Token data TTL in Redis (seconds)

# --- API Server (SSE) ---
POLYDROP_API_HOST=0.0.0.0
POLYDROP_API_PORT=3565
POLYDROP_SSE_INTERVAL=1.0                  # Seconds between SSE pushes
